---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { slugFromId, sortNewest } from '../../lib/content';

const projects = sortNewest((await getCollection('projects')).filter((entry) =>
  !entry.data.draft && slugFromId(entry.id) !== 'viq-simplevla-rl'
));
const projectPriority = [
  'quadruped-locomotion',
  'causally-invariant-reward-learning',
  'sliced-wasserstein-imitation-learning',
  'fastrl',
];
const orderedProjects = [...projects].sort((left, right) => {
  const leftRank = projectPriority.indexOf(slugFromId(left.id));
  const rightRank = projectPriority.indexOf(slugFromId(right.id));
  return (leftRank < 0 ? projectPriority.length : leftRank)
    - (rightRank < 0 ? projectPriority.length : rightRank);
});
---

<BaseLayout title="Selected work" description="Research on robust reinforcement learning, learned objectives, imitation, and agent behavior under distribution shift.">
  <section class="page-hero container">
    <p class="eyebrow">Research and deployment</p>
    <h1 class="page-title">Selected work</h1>
    <p class="page-lead">Research on robust reinforcement learning, learned objectives, imitation, and agent behavior under distribution shift.</p>
  </section>
  <section class="container"><div class="card-grid">{orderedProjects.map((project) => <ProjectCard entry={project} />)}</div></section>
</BaseLayout>
