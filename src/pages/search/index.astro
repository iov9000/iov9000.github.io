---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search ovinnikov.com." noindex>
  <section class="search-shell">
    <p class="eyebrow">Site search</p>
    <h1 class="page-title">Search</h1>
    <form class="search-form" id="search-form" role="search">
      <input id="search-input" type="search" name="q" placeholder="Search publications, work, and notes" autocomplete="off" />
      <button class="button" type="submit">Search</button>
    </form>
    <p class="search-status" id="search-status" aria-live="polite"></p>
    <div class="search-results" id="search-results"></div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#search-form');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const status = document.querySelector<HTMLElement>('#search-status');
  const results = document.querySelector<HTMLElement>('#search-results');

  const runSearch = async (query: string) => {
    if (!query || !status || !results) return;

    status.textContent = 'Searching…';
    results.replaceChildren();

    try {
      const loadModule = new Function('path', 'return import(path)');
      const pagefind = await loadModule('/pagefind/pagefind.js');
      const response = await pagefind.search(query);
      const items = await Promise.all(response.results.slice(0, 12).map((result: { data: () => Promise<any> }) => result.data()));
      status.textContent = `${items.length} result${items.length === 1 ? '' : 's'}`;

      for (const item of items) {
        const article = document.createElement('article');
        article.className = 'search-result';
        const heading = document.createElement('h2');
        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.meta.title;
        heading.append(link);
        const excerpt = document.createElement('p');
        excerpt.innerHTML = item.excerpt;
        article.append(heading, excerpt);
        results.append(article);
      }
    } catch {
      status.textContent = 'The search index is generated by npm run build and is unavailable in the development server.';
    }
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value.trim() ?? '';
    const url = new URL(window.location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    void runSearch(query);
  });

  const initialQuery = new URLSearchParams(window.location.search).get('q')?.trim() ?? '';
  if (initialQuery && input) {
    input.value = initialQuery;
    void runSearch(initialQuery);
  }
</script>
