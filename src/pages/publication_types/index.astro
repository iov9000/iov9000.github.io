---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publicationType } from '../../lib/content';

const publications = await getCollection('publications');
const counts = new Map<string, number>();
for (const entry of publications) {
  for (const type of entry.data.publication_types) counts.set(type, (counts.get(type) ?? 0) + 1);
}
---

<BaseLayout title="Publication types" description="Browse publications by type.">
  <section class="page-hero container"><p class="eyebrow">Browse</p><h1 class="page-title">Publication types</h1></section>
  <section class="container"><div class="publication-list">{[...counts].map(([type, count]) => <a class="publication-row" href={`/publication_types/${type}/`}><span>{count}</span><h2>{publicationType(type)}</h2><span class="row-link">View →</span></a>)}</div></section>
</BaseLayout>
