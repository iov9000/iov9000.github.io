---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationRow from '../components/PublicationRow.astro';
import { profile } from '../data/profile';
import { slugFromId, sortNewest } from '../lib/content';

const projects = sortNewest((await getCollection('projects')).filter((entry) => !entry.data.draft));
const projectPriority = [
  'quadruped-locomotion',
  'causally-invariant-reward-learning',
  'sliced-wasserstein-imitation-learning',
  'viq-simplevla-rl',
];
const selectedProjects = projects.filter((entry) => projectPriority.includes(slugFromId(entry.id))).sort((left, right) => {
  const leftRank = projectPriority.indexOf(slugFromId(left.id));
  const rightRank = projectPriority.indexOf(slugFromId(right.id));
  return (leftRank < 0 ? projectPriority.length : leftRank)
    - (rightRank < 0 ? projectPriority.length : rightRank);
});
const publications = sortNewest(await getCollection('publications'));
const featuredPublications = publications.filter((entry) => entry.data.featured);
const primaryProjects = selectedProjects.filter((entry) => slugFromId(entry.id) !== 'viq-simplevla-rl');
const ongoingProject = selectedProjects.find((entry) => slugFromId(entry.id) === 'viq-simplevla-rl');
const social = Object.fromEntries(profile.socials.map((entry) => [entry.label, entry]));
const heroLinks = [social['Google Scholar'], social.GitHub, { label: 'CV', url: '/uploads/resume.pdf' }, social.LinkedIn, social.Email];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  worksFor: { '@type': 'Organization', name: profile.company },
  url: 'https://ovinnikov.com/',
  sameAs: profile.socials.filter((social) => social.url.startsWith('http')).map((social) => social.url),
};
---

<BaseLayout description={profile.summary}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <section class="hero">
    <div class="container hero-grid">
      <div class="portrait-wrap">
        <Image class="portrait" src={avatar} alt={profile.name} width={440} height={440} priority />
      </div>
      <div>
        <h1>{profile.name}</h1>
        <p class="hero-thesis">{profile.headline}</p>
        <p class="hero-subtitle">{profile.subtitle}</p>
        <p class="hero-affiliation">{profile.credentials}</p>
        <nav class="hero-links" aria-label="Profile links">
          {heroLinks.map((link) => (
            <a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noreferrer' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title">Selected research</h2>
      </header>
      <div class="card-grid">
        {primaryProjects.map((project) => <ProjectCard entry={project} />)}
      </div>
      {ongoingProject && (
        <a class="ongoing-research" href={`/project/${slugFromId(ongoingProject.id)}/`}>
          <span class="card-meta">{ongoingProject.data.status}</span>
          <span>
            <strong>{ongoingProject.data.title}</strong>
            <span>{ongoingProject.data.summary}</span>
          </span>
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </section>

  <section class="section" id="themes">
    <div class="container">
      <header class="section-header themes-intro">
        <p class="eyebrow">Research themes</p>
        <p class="research-statement">{profile.about[0]}</p>
      </header>
      <div class="research-theme-grid">
        {profile.researchThemes.map((theme) => (
          <article class="research-theme">
            <h2>{theme.title}</h2>
            <p>{theme.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="papers">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title">Publications</h2>
      </header>
      <div class="publication-list">
        {featuredPublications.slice(0, 5).map((publication) => <PublicationRow entry={publication} />)}
      </div>
      <p style="margin-top: 1.5rem"><a class="button button-secondary" href="/publication/">All publications</a></p>
    </div>
  </section>

  <section class="section" id="background">
    <div class="container position-summary">
      <header>
        <p class="eyebrow">Background</p>
        <h2 class="section-title">Methods from learning signal to deployment</h2>
      </header>
      <div>
        <p>At <a href="https://www.anybotics.com/" target="_blank" rel="noreferrer">ANYbotics</a>, I develop and evaluate locomotion policies for industrial quadruped robots. My ETH Zürich PhD focused on reinforcement learning from demonstrations, reward inference, and distribution shift in surgical digital twins.</p>
        <p>I build experiments with PyTorch, JAX, GPU simulation, reproducible evaluation, and HPC workflows.</p>
        <p><a class="text-link" href="/experience/">Experience and education <Icon name="arrow-right" size={16} /></a></p>
      </div>
    </div>
  </section>
</BaseLayout>
