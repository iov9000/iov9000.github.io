---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = 'Applied scientist and ML researcher working on reinforcement learning, simulation, reward learning, and physical AI.',
  image = '/img/android-chrome-512x512.png',
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · Ivan Ovinnikov` : 'Ivan Ovinnikov · Applied Scientist';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/img/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Ivan Ovinnikov" href="/index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const preferred = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header pathname={Astro.url.pathname} />
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
