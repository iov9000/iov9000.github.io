---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { formatDate } from '../lib/content';
import katexCss from 'katex/dist/katex.min.css?url';

interface Link {
  name: string;
  url: string;
}

interface Fact {
  label: string;
  value: string;
}

interface NavItem {
  label: string;
  url: string;
}

interface Props {
  title: string;
  summary: string;
  date: Date;
  dateLabel?: string;
  authors?: string[];
  links?: Link[];
  facts?: Fact[];
  tags?: string[];
  backUrl: string;
  backLabel: string;
  math?: boolean;
  citeUrl?: string;
  displaySummary?: boolean;
  previous?: NavItem;
  next?: NavItem;
}

const {
  title,
  summary,
  date,
  dateLabel,
  authors = [],
  links = [],
  facts = [],
  tags = [],
  backUrl,
  backLabel,
  math = false,
  citeUrl,
  displaySummary = true,
  previous,
  next,
} = Astro.props;
---

<BaseLayout title={title} description={summary} type="article" publishedTime={dateLabel ? undefined : date}>
  {math && <link slot="head" rel="stylesheet" href={katexCss} />}
  <article class="article-shell">
    <a class="back-link" href={backUrl}><Icon name="arrow-left" size={16} /> {backLabel}</a>
    <header>
      <h1 class="article-title">{title}</h1>
      {displaySummary && summary && <p class="article-summary">{summary}</p>}
      <div class="article-byline">
        {dateLabel ? <span>{dateLabel}</span> : <time datetime={date.toISOString()}>{formatDate(date)}</time>}
        {authors.length > 0 && <span>·</span>}
        {authors.length > 0 && <span>{authors.join(', ')}</span>}
      </div>

      {(links.length > 0 || citeUrl) && (
        <div class="article-links">
          {links.map((link) => (
            <a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noreferrer' : undefined}>
              {link.name} {link.url.startsWith('http') && <Icon name="external" size={14} />}
            </a>
          ))}
          {citeUrl && <a href={citeUrl}>BibTeX</a>}
        </div>
      )}

      {facts.length > 0 && (
        <dl class="publication-facts">
          {facts.map((fact) => <div class="fact"><dt>{fact.label}</dt><dd set:html={fact.value} /></div>)}
        </dl>
      )}
    </header>

    <hr class="article-divider" />
    <div class="prose"><slot /></div>

    {tags.length > 0 && (
      <div class="article-taxonomy">
        {tags.map((tag) => <a class="tag" href={`/tags/${tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/`}>{tag}</a>)}
      </div>
    )}

    {(previous || next) && (
      <nav class="article-nav" aria-label="Related entries">
        {previous ? <a href={previous.url}>← {previous.label}</a> : <span />}
        {next && <a href={next.url}>{next.label} →</a>}
      </nav>
    )}
  </article>
</BaseLayout>
